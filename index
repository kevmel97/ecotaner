<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
(() => {
  'use strict';
  const $ = id => document.getElementById(id);
  const NOTE_NAMES = ['C','C♯','D','D♯','E','F','F♯','G','G♯','A','A♯','B'];
  const BRAND_ASSETS = {logo: 'data:image/png;base64,', images: {guitar: 'data:image/png;base64,', guitalele: 'data:image/png;base64,', ukulele: 'data:image/png;base64,', charango: 'data:image/png;base64,'}};
  const INSTRUMENTS = {
    guitar: {name:'Guitarra', desc:'6 cuerdas', icon:'🎸', presets:[
      {id:'standard',name:'Estándar · E A D G B E', notes:['E2','A2','D3','G3','B3','E4']},
      {id:'dropd',name:'Drop D · D A D G B E', notes:['D2','A2','D3','G3','B3','E4']},
      {id:'dadgad',name:'DADGAD · D A D G A D', notes:['D2','A2','D3','G3','A3','D4']},
      {id:'half',name:'½ tono abajo · E♭ A♭ D♭ G♭ B♭ E♭',notes:['D♯2','G♯2','C♯3','F♯3','A♯3','D♯4']}
    ]},
    guitalele: {name:'Guitalele',desc:'6 cuerdas',icon:'🎶',presets:[
      {id:'standard',name:'Estándar · A D G C E A',notes:['A2','D3','G3','C4','E4','A4']},
      {id:'half',name:'½ tono abajo · A♭ D♭ G♭ B E♭ A♭',notes:['G♯2','C♯3','F♯3','B3','D♯4','G♯4']},
      {id:'whole',name:'Un tono abajo · G C F B♭ D G',notes:['G2','C3','F3','A♯3','D4','G4']}
    ]},
    ukulele: {name:'Ukelele',desc:'4 cuerdas',icon:'🪕',presets:[
      {id:'standard',name:'Soprano / concierto · G C E A',notes:['G4','C4','E4','A4']},
      {id:'lowg',name:'Low G · G C E A',notes:['G3','C4','E4','A4']},
      {id:'baritone',name:'Barítono · D G B E',notes:['D3','G3','B3','E4']},
      {id:'d',name:'Afinación D · A D F♯ B',notes:['A4','D4','F♯4','B4']}
    ]},
    charango: {name:'Charango',desc:'10 cuerdas · 5 pares',icon:'🪕',presets:[
      {id:'standard',name:'Temple natural · G G C C E E A A E E',notes:['G4','G4','C5','C5','E5','E4','A4','A4','E5','E5']},
      {id:'thirdlow',name:'Natural · 3.er par Mi grave primero',notes:['G4','G4','C5','C5','E4','E5','A4','A4','E5','E5']},
      {id:'low',name:'Temple bajo · F F B♭ B♭ D D G G D D',notes:['F4','F4','A♯4','A♯4','D5','D4','G4','G4','D5','D5']}
    ]}
  };
  const storageKey='ecotaner_tunings_v1';
  let custom = {};
  try {custom=JSON.parse(localStorage.getItem(storageKey)||'{}')||{};} catch {}
  let instrument='guitar', presetId='standard', mode='auto', selected=0, a4=440;
  let micStream=null, micContext=null, analyser=null, sampleBuffer=null, frameHandle=0, lastSampleTime=0;
  let toneContext=null, pitchHistory=[], lastGoodPitch=0, lastGoodTime=0, toastTimeout=0;
  let draftNotes=[];
  const iconSound='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H3v6h3l5 4V5Z"/><path d="M15 9a5 5 0 0 1 0 6m3-9a9 9 0 0 1 0 12"/></svg>';
  const iconMic='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="9" y="2.5" width="6" height="12" rx="3"/><path d="M5 10v2a7 7 0 0 0 14 0v-2M12 19v3m-4 0h8"/></svg>';
  const iconStop='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>';
  function parseNote(note) {
    const match=/^([A-G])([#♯b♭]?)(-?\d)$/.exec(note);
    if(!match) return 69;
    const step={C:0,D:2,E:4,F:5,G:7,A:9,B:11}[match[1]]+(match[2]==='#'||match[2]==='♯'?1:match[2]==='b'||match[2]==='♭'?-1:0);
    return (+match[3]+1)*12+step;
  }
  function midiNote(midi) {return NOTE_NAMES[((midi%12)+12)%12]+(Math.floor(midi/12)-1);}
  function fmtNote(note) {return note.replace('♯','#').replace('♭','b');}
  function hz(note) {return a4*Math.pow(2,(parseNote(note)-69)/12);}
  const currentPreset=()=>{
    if(presetId.startsWith('custom:')) return (custom[instrument]||[]).find(p=>p.id===presetId)||INSTRUMENTS[instrument].presets[0];
    return INSTRUMENTS[instrument].presets.find(p=>p.id===presetId)||INSTRUMENTS[instrument].presets[0];
  };
  function toast(message) {
    const el=$('toast');el.textContent=message;el.classList.add('show');clearTimeout(toastTimeout);toastTimeout=setTimeout(()=>el.classList.remove('show'),3100);
  }

  // Dibujos SVG integrados en el archivo: funcionan sin conexión, no dependen de fotografías.
  function instrumentArt(type){
    const cfg={guitar:{wood:'#c68d60',edge:'#6f4d37',glow:'#ffdfb4',round:1},guitalele:{wood:'#bd9470',edge:'#594a39',glow:'#a7f7da',round:.94},ukulele:{wood:'#d3a370',edge:'#624b3a',glow:'#f2e9ac',round:.86},charango:{wood:'#bd785a',edge:'#694348',glow:'#f2c2d6',round:.89}}[type]||{wood:'#c68d60',edge:'#6f4d37',glow:'#ffdfb4',round:1};
    const rid='art-'+type;
    const frets=Array.from({length:13},(_,i)=>{const y=155+i*12.8;return `<line x1="117" y1="${y}" x2="143" y2="${y}" stroke="#f5d29f" stroke-opacity=".65" stroke-width="${i===0?3:1.6}"/>`;}).join('');
    const strings=Array.from({length:type==='ukulele'?4:type==='charango'?10:6},(_,i,a)=>{const count=type==='ukulele'?4:type==='charango'?10:6,x=119+i*(22/(count-1));return `<line x1="${x}" y1="76" x2="${x}" y2="490" stroke="#fff2d4" stroke-width="${i%2===0?1.1:.75}" stroke-opacity=".7"/>`;}).join('');
    const pegs=Array.from({length:6},(_,i)=>{const y=49+i*14;return `<g><line x1="${i%2===0?112:148}" y1="${y}" x2="${i%2===0?94:166}" y2="${y-3}" stroke="#dcc8b5" stroke-width="4" stroke-linecap="round"/><circle cx="${i%2===0?94:166}" cy="${y-3}" r="6" fill="#b8c6c3" stroke="#ffffff80" stroke-width="1"/></g>`;}).join('');
    const body=type==='charango'?'M130 253 C99 227 68 269 67 306 C68 344 100 355 98 393 C95 424 57 448 57 499 C57 562 87 594 130 592 C173 594 203 562 203 499 C203 448 165 424 162 393 C160 355 192 344 193 306 C192 269 161 227 130 253 Z':'M130 259 C103 236 70 263 74 303 C77 349 108 359 102 391 C97 418 62 438 59 495 C55 555 90 592 130 591 C170 592 205 555 201 495 C198 438 163 418 158 391 C152 359 183 349 186 303 C190 263 157 236 130 259 Z';
    return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 260 620" role="img" aria-label="Ilustración de ${type}"><defs><linearGradient id="${rid}-w" x1="0" y1="0" x2="1" y2="1"><stop stop-color="${cfg.glow}"/><stop offset=".47" stop-color="${cfg.wood}"/><stop offset="1" stop-color="${cfg.edge}"/></linearGradient><linearGradient id="${rid}-neck" x1="0" y1="0" x2="1" y2="0"><stop stop-color="#583e34"/><stop offset=".5" stop-color="#a6754f"/><stop offset="1" stop-color="#4b392e"/></linearGradient></defs><g transform="translate(130 320) scale(${cfg.round}) translate(-130 -320)"><path d="${body}" fill="url(#${rid}-w)" stroke="#f3ca92" stroke-width="5"/><path d="${body}" fill="none" stroke="#6f3c2c" stroke-width="13" stroke-opacity=".43" transform="translate(0 0) scale(.98 1) translate(2.6 0)"/><rect x="113" y="110" width="34" height="240" rx="8" fill="url(#${rid}-neck)" stroke="#efd0ac" stroke-width="3"/><path d="M113 113 L112 41 Q130 16 148 41 L147 113Z" fill="url(#${rid}-w)" stroke="#fae1ba" stroke-width="3"/>${pegs}<rect x="117" y="144" width="26" height="196" rx="3" fill="#472d27" stroke="#d6a16d" stroke-width="2"/>${frets}<circle cx="130" cy="389" r="37" fill="#d5a86a" stroke="#553c30" stroke-width="7"/><circle cx="130" cy="389" r="29" fill="#1a2229" stroke="#e4bf91" stroke-width="4"/><circle cx="130" cy="389" r="23" fill="#121c23" stroke="#eac69c" stroke-opacity=".55" stroke-width="2"/>${type==='charango'?'<circle cx="130" cy="389" r="16" fill="none" stroke="#edb3b5" stroke-width="6" stroke-dasharray="4 4"/>':''}<path d="M98 498 Q130 488 162 498 L159 510 Q130 502 101 510 Z" fill="#51372c" stroke="#ddad79" stroke-width="2"/>${strings}<path d="M83 502 C87 536 104 560 130 565" fill="none" stroke="#fff7de" stroke-opacity=".16" stroke-width="7" stroke-linecap="round"/></g></svg>`;
  }
  let tunedStrings=new Set(), inTuneSince=0, inTuneCandidate=-1;
  function resetTuned(){tunedStrings.clear();inTuneSince=0;inTuneCandidate=-1;}
  function enterInstrument(key){
    if(!INSTRUMENTS[key])return;
    if(micStream)stopMic();
    instrument=key;presetId=INSTRUMENTS[key].presets[0].id;selected=0;mode='auto';pitchHistory=[];lastGoodPitch=0;resetTuned();
    $('home-screen').hidden=true;$('tuning-screen').hidden=false;document.body.classList.add('in-tuning');
    renderAll();clearReading();window.scrollTo({top:0,behavior:'instant'});
  }
  function showMenu(){
    if(micStream)stopMic();
    closeEditor();$('home-screen').hidden=false;$('tuning-screen').hidden=true;document.body.classList.remove('in-tuning');
    window.scrollTo({top:0,behavior:'instant'});
  }
  function renderMenuCards(){
    $('instrument-grid').innerHTML=Object.entries(INSTRUMENTS).map(([key,i])=>`<button type="button" class="instrument-card" data-inst="${key}" aria-label="Afinar ${i.name}"><div class="card-art"><img src="${BRAND_ASSETS.images[key]}" alt="${i.name}"></div><span class="card-kicker">${i.desc}</span><h2 class="card-title">${i.name}</h2><p class="card-subtitle">${i.presets.length} afinaciones incluidas · modo automático y manual</p><span class="card-action">Afinar ahora <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></span></button>`).join('');
    $('instrument-grid').querySelectorAll('[data-inst]').forEach(b=>b.addEventListener('click',()=>enterInstrument(b.dataset.inst)));
  }
  function renderTabs(){
    $('instrument-heading').textContent=INSTRUMENTS[instrument].name;
    $('instrument-watermark').innerHTML=`<img src="${BRAND_ASSETS.images[instrument]}" alt="${INSTRUMENTS[instrument].name}">`;
  }

  function renderPresets(){
    const select=$('preset-select');select.innerHTML='';
    for(const preset of [...INSTRUMENTS[instrument].presets,...(custom[instrument]||[])]){
      const opt=document.createElement('option');opt.value=preset.id;opt.textContent=preset.name;select.append(opt);
    }
    select.value=presetId;
    const p=currentPreset();
    $('string-count').textContent=`${p.notes.length} cuerdas${instrument==='charango'&&p.notes.length===10?' · 5 pares':''} · ${p.name.split('·')[0].trim().toLowerCase()}`;
  }
  function stringDescription(index,total){
    if(instrument==='charango' && total===10){
      const pair=5-Math.floor(index/2),letter=index%2?'B':'A';
      return {badge:pair+letter,label:`Par ${pair} · cuerda ${letter}`,mini:`PAR ${pair}${letter}`};
    }
    return {badge:String(total-index),label:(instrument==='charango'?'Orden ':'Cuerda ')+(total-index),mini:'C. '+(total-index)};
  }
  function renderStrings(){
    const p=currentPreset(),container=$('strings-list');container.innerHTML='';
    p.notes.forEach((note,index)=>{
      const info=stringDescription(index,p.notes.length);
      const row=document.createElement('div');row.className='string-row'+(selected===index?' selected':'')+(tunedStrings.has(index)?' in-tune':'');
      row.setAttribute('role','group');row.setAttribute('aria-label',`${info.label}: ${note}`);
      const stringNumber=document.createElement('span');stringNumber.className='string-no';stringNumber.textContent=tunedStrings.has(index)?'✓':info.badge;
      const copy=document.createElement('div');copy.className='string-copy';const label=document.createElement('b');label.textContent=fmtNote(note);
      const secondary=document.createElement('small');secondary.textContent=(tunedStrings.has(index)?'✓ Afinada · ':'')+info.label;
      copy.append(label,secondary);const freq=document.createElement('span');freq.className='string-freq';freq.textContent=hz(note).toFixed(1)+' Hz';
      row.append(stringNumber,copy,freq);row.tabIndex=0;
      row.addEventListener('click',()=>selectString(index));row.addEventListener('keydown',e=>{if(e.target===row&&(e.key==='Enter'||e.key===' ')){e.preventDefault();selectString(index);}});
      const speaker=document.createElement('button');speaker.type='button';speaker.className='speaker';speaker.innerHTML=iconSound;speaker.setAttribute('aria-label',`Escuchar ${note}, ${info.label}`);speaker.addEventListener('click',e=>{e.stopPropagation();playReference(note);});
      row.append(speaker);container.append(row);
    });
    $('quick-strings').classList.toggle('charango-grid',instrument==='charango' && p.notes.length===10);
    $('quick-strings').innerHTML='';
    p.notes.forEach((note,index)=>{
      const info=stringDescription(index,p.notes.length);
      const b=document.createElement('button');b.type='button';b.className='quick-string'+(selected===index?' selected':'')+(tunedStrings.has(index)?' done':'');
      const n=document.createElement('span');n.textContent=fmtNote(note);const sm=document.createElement('small');sm.textContent=info.mini;
      b.append(n,sm);b.title=`${info.label} · ${note}`;b.setAttribute('aria-label',`Seleccionar ${info.label}: ${note}`);
      b.addEventListener('click',()=>selectString(index));$('quick-strings').append(b);
    });
    $('tuned-progress').textContent=tunedStrings.size+' de '+p.notes.length+' cuerdas afinadas';
    $('tuned-progress').style.color=tunedStrings.size?'var(--mint)':'';
  }
  function renderMode(){
    $('auto-button').classList.toggle('active',mode==='auto');$('manual-button').classList.toggle('active',mode==='manual');
    updateTargetDisplay();
  }
  function renderAll(){renderTabs();renderPresets();renderStrings();renderMode();}
  function selectString(i){selected=i;mode='manual';renderStrings();renderMode();clearReading();}
  function targetString(){const notes=currentPreset().notes;return notes[Math.max(0,Math.min(selected,notes.length-1))];}
  function updateTargetDisplay(){
    const note=targetString();$('target-name').innerHTML='Nota objetivo: <strong>'+fmtNote(note)+'</strong>';
    $('target-frequency').textContent=hz(note).toFixed(1)+' Hz';
  }
  function arcPoint(deg,radius=166){const rad=deg*Math.PI/180;return [210+radius*Math.sin(rad),220-radius*Math.cos(rad)];}
  function arcPath(start,end,radius=166){const [sx,sy]=arcPoint(start,radius),[ex,ey]=arcPoint(end,radius);return `M ${sx.toFixed(2)} ${sy.toFixed(2)} A ${radius} ${radius} 0 0 1 ${ex.toFixed(2)} ${ey.toFixed(2)}`;}
  function setMeter(cents,active){
    const value=Math.max(-50,Math.min(50,cents||0)),angle=value/50*85,[x,y]=arcPoint(angle,151);
    ['meter-needle','needle-shadow'].forEach(id=>{$(id).setAttribute('x2',x.toFixed(2));$(id).setAttribute('y2',y.toFixed(2));$(id).style.opacity=active?'1':'.38';});
    const good=active&&Math.abs(cents)<=5;
    $('meter-needle').classList.toggle('good',good);$('pivot-inner').classList.toggle('good',good);$('pitch-main').classList.toggle('good',good);
  }
  function buildMeter(){
    const segments=[[-87,-66,'#f26f79'],[-65,-49,'#ff965f'],[-48,-34,'#ffbb61'],[-33,-20,'#f4db70'],[-19,-9,'#b6e779'],[-8,8,'#42efa4'],[9,19,'#b6e779'],[20,33,'#f4db70'],[34,48,'#ffbb61'],[49,65,'#ff965f'],[66,87,'#f26f79']];
    const ns='http://www.w3.org/2000/svg';$('dial-guide').setAttribute('d',arcPath(-90,90,166));
    segments.forEach(([start,end,color])=>{const path=document.createElementNS(ns,'path');path.setAttribute('d',arcPath(start,end,166));path.setAttribute('stroke',color);path.setAttribute('class','segment');$('meter-segments').append(path);});
    for(let cents=-50;cents<=50;cents+=5){const deg=cents/50*86,big=cents%25===0;
      const [x1,y1]=arcPoint(deg,big?134:139),[x2,y2]=arcPoint(deg,146);
      const line=document.createElementNS(ns,'line');line.setAttribute('x1',x1);line.setAttribute('y1',y1);line.setAttribute('x2',x2);line.setAttribute('y2',y2);line.setAttribute('class','tick'+(big?' major':'')+(cents===0?' center':''));$('meter-ticks').append(line);
    }
    [-50,-25,0,25,50].forEach(c=>{const [x,y]=arcPoint(c/50*86,110);const t=document.createElementNS(ns,'text');t.setAttribute('x',x);t.setAttribute('y',y+4);t.setAttribute('class','tick-label');t.textContent=c>0?'+'+c:String(c);$('meter-labels').append(t);});
  }
  function clearReading(){
    $('detected-name').textContent='♪';$('detected-octave').textContent='';$('detected-frequency').textContent='— Hz';
    $('cent-display').textContent='— cents';$('tune-status').textContent=micStream?'Toca una cuerda':'Listo para escuchar';
    $('tune-status').className='tune-status';inTuneSince=0;inTuneCandidate=-1;setMeter(0,false);updateTargetDisplay();
  }
  function showPitch(frequency){
    const midiFloat=69+12*Math.log2(frequency/a4);const detectedMidi=Math.round(midiFloat),name=midiNote(detectedMidi);
    if(mode==='auto'){
      const notes=currentPreset().notes;let best=Infinity,bestIndex=0;
      notes.forEach((note,i)=>{
        const diff=Math.abs(1200*Math.log2(frequency/hz(note)));
        // For identical notes, leave the second string for manual selection.
        if(diff<best-0.001){best=diff;bestIndex=i;}
      });
      if(selected!==bestIndex){selected=bestIndex;inTuneSince=0;inTuneCandidate=-1;renderStrings();}
    }
    const targetHz=hz(targetString()),cents=1200*Math.log2(frequency/targetHz),match=Math.abs(cents)<=5;
    $('detected-name').textContent=fmtNote(name).replace(/-?\d$/,'');$('detected-octave').textContent=name.match(/-?\d$/)?.[0]||'';
    $('detected-frequency').textContent=frequency.toFixed(1)+' Hz';
    $('cent-display').textContent=(cents>0?'+':'')+Math.round(cents)+' cents';
    $('tune-status').className='tune-status '+(match?'good':cents<0?'low':'high');
    $('tune-status').textContent=match?'¡Perfecta! La cuerda está afinada':cents<0?'Está grave · tensa un poco':'Está aguda · afloja un poco';
    if(match){
      const now=performance.now();if(inTuneCandidate!==selected){inTuneCandidate=selected;inTuneSince=now;}
      if(now-inTuneSince>450&&!tunedStrings.has(selected)){tunedStrings.add(selected);renderStrings();}
    } else {inTuneSince=0;inTuneCandidate=-1;}
    updateTargetDisplay();setMeter(cents,true);
  }
  // YIN pitch detection: difference function and cumulative normalized difference.
  // Optimized for plucked strings from ~65 Hz to 1,200 Hz.
  function detectPitch(data,sampleRate){
    const n=2048, minTau=Math.max(2,Math.floor(sampleRate/1200)),maxTau=Math.min(1200,Math.floor(sampleRate/65),data.length-n-1);
    let rms=0,mean=0;for(let i=0;i<n;i++)mean+=data[i];mean/=n;
    for(let i=0;i<n;i++){const v=data[i]-mean;rms+=v*v;}rms=Math.sqrt(rms/n);
    if(rms<0.009)return null;
    const d=new Float32Array(maxTau+1);
    let running=0,bestTau=0,bestCmnd=1;
    for(let tau=1;tau<=maxTau;tau++){
      let sum=0;
      for(let i=0;i<n;i++){const v=data[i]-data[i+tau];sum+=v*v;}
      running+=sum;d[tau]=running>0?sum*tau/running:1;
      if(tau>=minTau&&d[tau]<.16&&d[tau]<bestCmnd){bestCmnd=d[tau];bestTau=tau;}
    }
    if(!bestTau)return null;
    // Prefer the earliest local minimum below threshold, not a later subharmonic.
    for(let tau=minTau;tau<=maxTau;tau++){
      if(d[tau]<.16&&d[tau]<d[tau-1]&&d[tau]<=d[Math.min(maxTau,tau+1)]){bestTau=tau;break;}
    }
    const y0=d[bestTau-1],y1=d[bestTau],y2=d[bestTau+1];
    const denominator=y0+y2-2*y1;
    const interp=denominator!==0?.5*(y0-y2)/denominator:0;
    const freq=sampleRate/(bestTau+Math.max(-.5,Math.min(.5,interp)));
    return freq>=65&&freq<=1200?freq:null;
  }
  function sampleLoop(timestamp){
    if(!micStream||!analyser)return;
    frameHandle=requestAnimationFrame(sampleLoop);
    if(timestamp-lastSampleTime<105)return;
    lastSampleTime=timestamp;
    analyser.getFloatTimeDomainData(sampleBuffer);
    const pitch=detectPitch(sampleBuffer,micContext.sampleRate);
    if(pitch){
      pitchHistory.push(pitch);if(pitchHistory.length>5)pitchHistory.shift();
      const sorted=[...pitchHistory].sort((a,b)=>a-b);let stable=sorted[Math.floor(sorted.length/2)];
      // Reject one-frame octave errors; recover naturally on sustained notes.
      if(lastGoodPitch&&Math.abs(1200*Math.log2(stable/lastGoodPitch))>350){
        if(Math.abs(1200*Math.log2(pitch/lastGoodPitch))>350){pitchHistory=[pitch];stable=pitch;}else stable=lastGoodPitch;
      }
      lastGoodPitch=stable;lastGoodTime=timestamp;showPitch(stable);
    } else if(timestamp-lastGoodTime>850){pitchHistory=[];lastGoodPitch=0;clearReading();}
  }
  async function startMic(){
    if(!navigator.mediaDevices?.getUserMedia){toast('El micrófono requiere HTTPS o localhost en un navegador compatible.');return;}
    $('mic-button').disabled=true;$('mic-button-text').textContent='Solicitando permiso…';
    try {
      const stream=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:false,noiseSuppression:false,autoGainControl:false},video:false});
      const context=new (window.AudioContext||window.webkitAudioContext)();await context.resume();
      const source=context.createMediaStreamSource(stream),an=context.createAnalyser();an.fftSize=4096;an.smoothingTimeConstant=0;source.connect(an);
      micStream=stream;micContext=context;analyser=an;sampleBuffer=new Float32Array(an.fftSize);pitchHistory=[];lastSampleTime=0;lastGoodTime=0;
      $('mic-label').classList.add('on');$('mic-label').querySelector('span').textContent='ESCUCHANDO';
      $('mic-button').classList.add('stop');$('mic-button').innerHTML=iconStop+'<span id="mic-button-text">Detener micrófono</span>';
      $('mic-hint').textContent='Toca una sola cuerda y espera a que se estabilice la lectura.';
      frameHandle=requestAnimationFrame(sampleLoop);clearReading();
    } catch(err){
      let message='No se pudo activar el micrófono.';
      if(err.name==='NotAllowedError'||err.name==='PermissionDeniedError')message='Debes permitir el acceso al micrófono en el navegador.';
      else if(err.name==='NotFoundError')message='No se encontró un micrófono conectado.';
      toast(message);
    } finally {$('mic-button').disabled=false;if(!micStream)$('mic-button').innerHTML=iconMic+'<span id="mic-button-text">Activar micrófono</span>';}
  }
  function stopMic(){
    cancelAnimationFrame(frameHandle);frameHandle=0;
    if(micStream)micStream.getTracks().forEach(track=>track.stop());micStream=null;
    if(micContext){micContext.close().catch(()=>{});micContext=null;}
    analyser=null;sampleBuffer=null;pitchHistory=[];lastGoodPitch=0;
    $('mic-label').classList.remove('on');$('mic-label').querySelector('span').textContent='MIC APAGADO';
    $('mic-button').classList.remove('stop');$('mic-button').innerHTML=iconMic+'<span id="mic-button-text">Activar micrófono</span>';
    $('mic-hint').textContent='El audio se analiza en tu dispositivo, sin subir grabaciones a internet.';
    clearReading();
  }
  async function playReference(note){
    try {
      if(!toneContext)toneContext=new (window.AudioContext||window.webkitAudioContext)();
      await toneContext.resume();const f=hz(note),now=toneContext.currentTime;
      const output=toneContext.createGain();output.gain.setValueAtTime(.0001,now);output.gain.exponentialRampToValueAtTime(.17,now+.035);output.gain.exponentialRampToValueAtTime(.0001,now+2.1);output.connect(toneContext.destination);
      const fundamental=toneContext.createOscillator();fundamental.type='sine';fundamental.frequency.value=f;fundamental.connect(output);fundamental.start(now);fundamental.stop(now+2.13);
      const upper=toneContext.createOscillator(),upperGain=toneContext.createGain();upper.type='triangle';upper.frequency.value=f*2;upperGain.gain.value=.14;upper.connect(upperGain);upperGain.connect(output);upper.start(now);upper.stop(now+1.7);
    } catch {toast('Tu navegador no permite reproducir audio en este momento.');}
  }
  function showEditor(){
    const p=currentPreset();draftNotes=[...p.notes];$('tuning-name').value=p.id.startsWith('custom:')?p.name:'Mi afinación';renderEditorStrings();$('editor-backdrop').classList.add('open');$('tuning-name').focus();
  }
  function renderEditorStrings(){
    const el=$('editor-strings');el.innerHTML='';
    draftNotes.forEach((note,index)=>{
      const row=document.createElement('div');row.className='editor-string';
      const label=document.createElement('span');label.textContent=stringDescription(index,draftNotes.length).badge;
      const select=document.createElement('select');select.setAttribute('aria-label',`Nota para cuerda ${draftNotes.length-index}`);
      for(let oct=2;oct<=6;oct++)for(let n=0;n<12;n++){
        const pitch=NOTE_NAMES[n]+oct,opt=document.createElement('option');opt.value=pitch;opt.textContent=pitch+' · '+(a4*Math.pow(2,((oct+1)*12+n-69)/12)).toFixed(1)+' Hz';select.append(opt);
      }
      select.value=midiNote(parseNote(note));select.addEventListener('change',()=>{draftNotes[index]=select.value;});
      const remove=document.createElement('button');remove.type='button';remove.textContent='×';remove.title='Eliminar cuerda';remove.disabled=draftNotes.length<=1;remove.addEventListener('click',()=>{draftNotes.splice(index,1);renderEditorStrings();});
      row.append(label,select,remove);el.append(row);
    });
    $('editor-string-count').textContent=draftNotes.length+' cuerdas';$('add-string').disabled=draftNotes.length>=10;
  }
  function closeEditor(){$('editor-backdrop').classList.remove('open');}
  function saveTuning(){
    const name=$('tuning-name').value.trim();if(!name){toast('Escribe un nombre para tu afinación.');return;}
    const safeName=name.slice(0,45);let id='custom:'+Date.now().toString(36);
    if(!custom[instrument])custom[instrument]=[];
    custom[instrument].push({id,name:safeName,notes:[...draftNotes]});
    try{localStorage.setItem(storageKey,JSON.stringify(custom));}catch{toast('No se pudo guardar permanentemente en este navegador.');}
    presetId=id;selected=0;resetTuned();closeEditor();renderPresets();renderStrings();clearReading();toast('Afinación «'+safeName+'» guardada.');
  }
  $('preset-select').addEventListener('change',e=>{presetId=e.target.value;selected=0;pitchHistory=[];resetTuned();renderPresets();renderStrings();clearReading();});
  $('auto-button').addEventListener('click',()=>{mode='auto';renderMode();clearReading();});
  $('manual-button').addEventListener('click',()=>{mode='manual';renderMode();clearReading();});
  $('mic-button').addEventListener('click',()=>{micStream?stopMic():startMic();});
  $('ref-minus').addEventListener('click',()=>changeA4(-1));$('ref-plus').addEventListener('click',()=>changeA4(1));
  function changeA4(n){a4=Math.max(430,Math.min(450,a4+n));$('reference-value').innerHTML=a4+' <span>Hz</span>';$('ref-minus').disabled=a4===430;$('ref-plus').disabled=a4===450;resetTuned();renderStrings();clearReading();}
  $('edit-button').addEventListener('click',showEditor);$('close-editor').addEventListener('click',closeEditor);$('cancel-editor').addEventListener('click',closeEditor);
  $('editor-backdrop').addEventListener('click',e=>{if(e.target===$('editor-backdrop'))closeEditor();});
  $('add-string').addEventListener('click',()=>{if(draftNotes.length<10){draftNotes.push('C4');renderEditorStrings();}});
  $('save-tuning').addEventListener('click',saveTuning);
  document.addEventListener('keydown',e=>{if(e.key==='Escape')closeEditor();});
  window.addEventListener('pagehide',()=>{if(micStream)stopMic();});
  $('back-button').addEventListener('click',showMenu);
  buildMeter();renderMenuCards();renderAll();clearReading();showMenu();
  // Mostrar símbolo durante 3 segundos y revelar la interfaz con una transición suave.
  window.setTimeout(()=>{
    const splash=document.getElementById('eco-splash');
    document.body.classList.remove('splash-active');
    if(splash){
      splash.classList.add('exit');
      window.setTimeout(()=>splash.remove(),750);
    }
  },3000);

})();
