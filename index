/* V6: luz RGB ambiental suave; el fondo sigue siendo oscuro y legible. */
body {
  background: linear-gradient(145deg,#08162c 0%,#0d2644 54%,#0a1c35 100%) !important;
  isolation: isolate;
}
body::before, body::after {
  content:"";
  position:fixed;
  inset:-25vh -25vw;
  pointer-events:none;
  z-index:0;
  will-change:transform,opacity;
}
body::before {
  background:
    radial-gradient(ellipse 37% 38% at 24% 25%,rgba(18,104,177,.45),transparent 83%),
    radial-gradient(ellipse 36% 43% at 81% 65%,rgba(33,177,145,.31),transparent 80%),
    radial-gradient(ellipse 40% 36% at 47% 88%,rgba(77,53,162,.28),transparent 80%);
  animation:eco-ambient-1 34s ease-in-out infinite;
}
body::after {
  background:
    radial-gradient(ellipse 32% 32% at 75% 17%,rgba(111,75,199,.22),transparent 83%),
    radial-gradient(ellipse 29% 39% at 17% 76%,rgba(31,170,165,.22),transparent 82%);
  animation:eco-ambient-2 44s ease-in-out infinite;
  opacity:.8;
}
.app {position:relative;z-index:1;transition:opacity .7s ease;}
body.splash-active .app {opacity:0;visibility:hidden;pointer-events:none;}

/* Entrada con el símbolo transparente; aparece solo durante 3 segundos. */
.eco-splash {
  position:fixed;
  z-index:9999;
  inset:0;
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
  background:radial-gradient(ellipse 65% 70% at 50% 42%,#153457 0%,#0c243f 58%,#07182d 100%);
  opacity:1;
  visibility:visible;
  transition:opacity .65s ease,visibility .65s ease;
}
.eco-splash::before{
  content:"";position:absolute;inset:-30%;pointer-events:none;
  background:radial-gradient(ellipse 38% 35% at 25% 45%,rgba(31,120,173,.22),transparent 90%),radial-gradient(ellipse 37% 35% at 75% 60%,rgba(54,145,132,.18),transparent 86%);
  animation:eco-ambient-1 34s ease-in-out infinite;
}
.eco-splash.exit{opacity:0;visibility:hidden;pointer-events:none;}
.eco-splash-inner{position:relative;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;gap:11px;padding:24px;animation:eco-logo-appear 1s cubic-bezier(.2,.8,.2,1) both;}
.eco-splash-mark{display:block;width:clamp(145px,24vw,220px);height:auto;aspect-ratio:332/345;object-fit:contain;filter:drop-shadow(0 12px 24px rgba(0,0,0,.20));animation:eco-logo-breathe 3s ease-in-out infinite;}
.eco-splash-name{font-weight:850;font-size:clamp(24px,4.5vw,39px);color:#f8fbff;letter-spacing:.19em;margin-top:4px;padding-left:.19em;line-height:1.15;}
.eco-splash-tagline{font-size:11px;letter-spacing:.28em;text-transform:uppercase;font-weight:650;color:#a9c6d9;}
@keyframes eco-ambient-1{
  0%,100%{transform:translate3d(-3%,0,0) scale(1);opacity:.70;filter:hue-rotate(0deg)}
  25%{transform:translate3d(6%,-3%,0) scale(1.08);opacity:1;filter:hue-rotate(36deg)}
  50%{transform:translate3d(2%,4%,0) scale(1.02);opacity:.78;filter:hue-rotate(94deg)}
  75%{transform:translate3d(-5%,3%,0) scale(1.06);opacity:.94;filter:hue-rotate(53deg)}
}
@keyframes eco-ambient-2{
  0%,100%{transform:translate3d(3%,-2%,0) scale(1.02);opacity:.58;filter:hue-rotate(0deg)}
  33%{transform:translate3d(-5%,4%,0) scale(1.09);opacity:.9;filter:hue-rotate(-38deg)}
  66%{transform:translate3d(3%,1%,0) scale(1.03);opacity:.62;filter:hue-rotate(50deg)}
}
@keyframes eco-logo-appear{from{opacity:0;transform:translateY(14px) scale(.95)}to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes eco-logo-breathe{0%,100%{transform:scale(1)}50%{transform:scale(1.025)}}
@media(prefers-reduced-motion:reduce){
